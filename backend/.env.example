# ── Nerum V2 backend env (template) ───────────────────────────────────
# Copy to .env and fill every value. No silent fallbacks: a missing
# DATABASE_URL / SECRET_KEY / ENCRYPTION_KEY crashes startup on purpose.

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SECRET_KEY=                 # python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=             # 64-char hex (32 bytes) for AES-256-GCM

RESEND_API_KEY=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=nerum_verify_2026
TELEGRAM_BOT_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ADMIN_SECRET=
FRONTEND_URL=http://localhost:3000
# Public site origin the browser is redirected to (OAuth, password reset, email
# links). Leave unset in prod to use the https://nerum.in default.
APP_URL=https://nerum.in
